{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://gvutkcqoameywszdstol.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "aesthetic-index-mcp",
      "version": "0.1.0",
      "title": "Aesthetic Index"
    },
    "tools": [
      {
        "name": "list_site_pages",
        "title": "List site pages",
        "description": "List every public URL on Aesthetic Index (static pages, treatment pages, comparison pages) so you can open and review them on the live site.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_treatments",
        "title": "List treatments",
        "description": "List the cosmetic treatment profiles on Aesthetic Index with their slug, category, review status and whether they are published.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Optional text to match against treatment name or slug.",
              "type": "string"
            },
            "limit": {
              "default": 50,
              "description": "Maximum number of rows to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_treatment",
        "title": "Get treatment profile",
        "description": "Read one treatment profile in full, including every editorial field and its cited sources. Use this to find gaps to fill.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Treatment slug, e.g. 'botox'."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_comparisons",
        "title": "List comparisons",
        "description": "List the side-by-side treatment comparison pages, including their slug, the two treatments compared and review status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_price_observations",
        "title": "List price observations",
        "description": "Read the publicly listed clinic price observations collected for a treatment, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "treatmentSlug": {
              "description": "Optional treatment slug filter, e.g. 'botox'.",
              "type": "string"
            },
            "limit": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_suggestions",
        "title": "List suggestions",
        "description": "Read suggestions already filed in the inbox, so you do not repeat one.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "new",
                "accepted",
                "rejected"
              ]
            },
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "suggest_change",
        "title": "Suggest a change",
        "description": "File a proposed improvement to the site: new content, corrections, missing data, or a Lovable prompt to run. It lands in the owner's suggestion inbox. Nothing is published by this tool.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "targetType": {
              "type": "string",
              "enum": [
                "treatment",
                "comparison",
                "price",
                "page",
                "other"
              ],
              "description": "What the suggestion is about."
            },
            "targetSlug": {
              "description": "Slug or path the suggestion applies to, if any.",
              "type": "string"
            },
            "title": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "description": "Short summary of the suggestion."
            },
            "body": {
              "type": "string",
              "minLength": 10,
              "maxLength": 8000,
              "description": "The detail: what to change and why. Include a ready-to-paste Lovable prompt when useful."
            },
            "sources": {
              "default": [],
              "description": "Source URLs backing any factual claim in the suggestion.",
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "required": [
            "targetType",
            "title",
            "body"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "update_treatment_fields",
        "title": "Update treatment fields",
        "description": "Update editorial text fields on a treatment profile. Admin-only: it fails for non-admin accounts. Never write medical advice, diagnosis or dosage; keep phrasing neutral and factual.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Treatment slug to update."
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "summary",
                  "primary_purpose",
                  "mechanism",
                  "result_timing",
                  "sessions_text",
                  "downtime_text",
                  "longevity_text",
                  "major_risks",
                  "most_likely_disappointment",
                  "marketing_misconception",
                  "provider_variables",
                  "skin_tone_notes",
                  "appointment_time",
                  "swelling_text",
                  "bruising_text",
                  "exercise_restrictions",
                  "what_it_changes",
                  "what_it_does_not_change",
                  "expected_result_magnitude",
                  "true_substitute_notes",
                  "when_not_appropriate",
                  "fda_status",
                  "canada_status"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "required": [
                "summary",
                "primary_purpose",
                "mechanism",
                "result_timing",
                "sessions_text",
                "downtime_text",
                "longevity_text",
                "major_risks",
                "most_likely_disappointment",
                "marketing_misconception",
                "provider_variables",
                "skin_tone_notes",
                "appointment_time",
                "swelling_text",
                "bruising_text",
                "exercise_restrictions",
                "what_it_changes",
                "what_it_does_not_change",
                "expected_result_magnitude",
                "true_substitute_notes",
                "when_not_appropriate",
                "fda_status",
                "canada_status"
              ],
              "description": "Map of editable field name to new text."
            }
          },
          "required": [
            "slug",
            "fields"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
